# ── 知乎开放平台 ─────────────────────────────────────────────────────────────
# 仅服务端使用，供搜索适配器调用 zhihu_search。
ZHIHU_ACCESS_SECRET=

# ── 知乎 OAuth 登录（黑客松）────────────────────────────────────────────────
# 创建赛事项目后由活动页面分配。回调地址必须与活动页面登记值完全一致，
# 协议、域名、端口、路径、结尾斜杠都要一一对应。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=https://your-demo.example.com/api/auth/zhihu/callback

# 用于加密登录会话 Cookie。至少 32 个字符，绝不提交到仓库。
SESSION_SECRET=

# ── 托管 SQLite（Turso）─────────────────────────────────────────────────────
# 可选。配置后线程、摘录和学习空间写入托管数据库，免费的无盘主机重启也不会丢数据；
# 未配置时回退到本地 SQLite 文件，适合开发和测试。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── 模型服务（兼容 OpenAI 协议）─────────────────────────────────────────────
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ── 本地数据库路径（开发时可覆盖）───────────────────────────────────────────
# DATABASE_PATH=.local/thread-artifacts.db
# EXCERPT_DB_PATH=.local/excerpts.db
# QUOTA_DB_PATH=.local/provider-quota.db
