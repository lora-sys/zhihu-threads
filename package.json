{
  "name": "zhihu-threads",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "preview": "vp preview",
    "eval": "EVAL_V3_COMMAND=run vp exec vitest run src/evals/v3/live.test.ts",
    "eval:legacy": "EVAL_COMMAND=run vp exec vitest run src/evals/eval-harness.test.ts",
    "eval:offline": "node --unhandled-rejections=strict --experimental-strip-types src/evals/v3/offline.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "effect": "^3.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-sqlite3": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  }
}
